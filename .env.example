# Copy this file to .env and fill in real values for local development.
# (In GitHub Actions, these are set as repo secrets instead — see
# .github/workflows/audit.yml. Note the one naming difference: the
# Actions secret is called GH_PAT, but it's passed into this script as
# GITHUB_TOKEN below — same value, different name in the two places.)

# A GitHub personal access token for the account this bot operates as.
# Needs: repo access (to open issues/PRs), and the ability to fork
# public repos. https://github.com/settings/tokens
GITHUB_TOKEN=

# Primary LLM provider. Get a free key at https://openrouter.ai/keys
# Free tier is request-capped (50/day unfunded, 1,000/day after a one-time
# $10 credit purchase) — see README "Honest limitations" for what happens
# when that cap is hit mid-run (nothing breaks; it falls through to Groq,
# then Gemini, below).
OPENROUTER_API_KEY=

# First fallback if OpenRouter fails or is rate-limited.
# Free key at https://console.groq.com/keys
GROQ_API_KEY=

# Last-resort fallback. Free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
